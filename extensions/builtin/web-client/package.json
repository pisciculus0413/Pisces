{
  "name": "@pisces/web-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "pisces": {
    "clients": [
      {
        "id": "web",
        "entry": "./dist/server.js"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@pisces/protocol": "workspace:*",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
