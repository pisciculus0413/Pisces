{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@pisces/protocol": ["./packages/protocol/src/index.ts"],
      "@pisces/core": ["./packages/core/src/index.ts"],
      "@pisces/daemon": ["./packages/daemon/src/index.ts"]
